    <diagram id="direct-gray-pixel" name="Direct RGB_BW Output Connection">
        <mxGraphModel dx="657" dy="804" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=23;fontStyle=1;align=center;" value="RGB-to-Grayscale Processor - Updated Direct Output Data Path" vertex="1">
