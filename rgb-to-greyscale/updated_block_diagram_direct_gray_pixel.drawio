                </mxCell>
                <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#555555;align=center;" value="RGB_BW.v creates gray_pixel[23:0] directly; controller supplies only address and write-enable" vertex="1">
                    <mxGeometry height="30" width="1120" x="390" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="top" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontSize=16;fontStyle=1;" value="Top.v" vertex="1">
                    <mxGeometry height="900" width="1450" x="230" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="external" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontSize=13;" value="&lt;b&gt;Top.v external ports&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;clk&lt;br&gt;reset&lt;br&gt;load_en&lt;br&gt;load_addr[13:0]&lt;br&gt;load_pixel[23:0]&lt;br&gt;start&lt;br&gt;read_en&lt;br&gt;read_addr[13:0]&lt;br&gt;&lt;br&gt;&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;read_pixel[23:0]&lt;br&gt;output_valid&lt;br&gt;busy&lt;br&gt;done" vertex="1">
                    <mxGeometry height="350" width="185" x="20" y="280" as="geometry"/>
                </mxCell>
                <mxCell id="controller" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontSize=12;" value="&lt;b&gt;controller.v - FSM&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;clk, reset, start&lt;br&gt;load_en, load_addr[13:0]&lt;br&gt;load_pixel[23:0]&lt;br&gt;read_en, read_addr[13:0]&lt;br&gt;input_pixel[23:0]&lt;br&gt;input_read_valid&lt;br&gt;&lt;br&gt;&lt;b&gt;Internal&lt;/b&gt;&lt;br&gt;pixel_count[13:0]&lt;br&gt;&lt;br&gt;&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;input_mem_read_en&lt;br&gt;input_mem_read_addr[13:0]&lt;br&gt;input_mem_write_en&lt;br&gt;input_mem_write_addr[13:0]&lt;br&gt;input_mem_write_data[23:0]&lt;br&gt;output_mem_write_en&lt;br&gt;output_mem_write_addr[13:0]&lt;br&gt;output_mem_read_en&lt;br&gt;output_mem_read_addr[13:0]&lt;br&gt;busy, done, output_valid&lt;br&gt;&lt;br&gt;&lt;b&gt;No output_mem_write_data&lt;/b&gt;" vertex="1">
                    <mxGeometry height="650" width="315" x="270" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="inputmem" parent="1" style="shape=mxgraph.basic.cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;spacingTop=12;fontSize=12;" value="&lt;b&gt;input_memory.v&lt;/b&gt;&lt;br&gt;Synchronous RGB memory&lt;br&gt;&lt;br&gt;&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;clk&lt;br&gt;write_en&lt;br&gt;write_addr[13:0]&lt;br&gt;write_data[23:0]&lt;br&gt;read_en&lt;br&gt;read_addr[13:0]&lt;br&gt;&lt;br&gt;&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;read_data[23:0]&lt;br&gt;read_valid&lt;br&gt;&lt;br&gt;16,384 x 24 bits" vertex="1">
                    <mxGeometry height="300" width="270" x="650" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="rgbbw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontSize=12;" value="&lt;b&gt;RGB_BW.v&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;red[7:0] = input_pixel[23:16]&lt;br&gt;green[7:0] = input_pixel[15:8]&lt;br&gt;blue[7:0] = input_pixel[7:0]&lt;br&gt;&lt;br&gt;gray = (54R + 182G + 18B) &gt;&gt; 8&lt;br&gt;&lt;br&gt;&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;gray_pixel[23:0] = {gray, gray, gray}&lt;br&gt;&lt;br&gt;Combinational; no clk required" vertex="1">
                    <mxGeometry height="300" width="340" x="980" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="outputmem" parent="1" style="shape=mxgraph.basic.cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;spacingTop=12;fontSize=12;" value="&lt;b&gt;output_memory.v&lt;/b&gt;&lt;br&gt;Synchronous output RGB memory&lt;br&gt;&lt;br&gt;&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;clk&lt;br&gt;write_en &lt;-- FSM&lt;br&gt;write_addr[13:0] &lt;-- FSM&lt;br&gt;write_data[23:0] &lt;-- RGB_BW.gray_pixel&lt;br&gt;read_en&lt;br&gt;read_addr[13:0]&lt;br&gt;&lt;br&gt;&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;read_data[23:0]&lt;br&gt;read_valid&lt;br&gt;&lt;br&gt;16,384 x 24 bits" vertex="1">
                    <mxGeometry height="300" width="340" x="980" y="620" as="geometry"/>
                </mxCell>
                <mxCell id="output" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingTop=12;spacingLeft=12;fontSize=14;" value="&lt;b&gt;Output/readback&lt;/b&gt;&lt;br&gt;read_pixel[23:0]&lt;br&gt;output_valid&lt;br&gt;busy&lt;br&gt;done" vertex="1">
                    <mxGeometry height="170" width="185" x="1450" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontSize=13;" value="&lt;b&gt;Key update&lt;/b&gt;&lt;br&gt;The RGB_BW output is connected directly to output_memory.write_data.&lt;br&gt;&lt;br&gt;The FSM controls only:&lt;br&gt;- output_mem_write_en&lt;br&gt;- output_mem_write_addr[13:0]&lt;br&gt;- output read controls&lt;br&gt;&lt;br&gt;No output_mem_write_data signal is generated by the FSM." vertex="1">
                    <mxGeometry height="220" width="185" x="20" y="720" as="geometry"/>
                </mxCell>
